{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@complinter/core": [
        "packages/core/src/index.ts"
      ],
      "@complinter/lang-typescript": [
        "packages/lang-typescript/src/index.ts"
      ],
      "@complinter/rules-gdpr": [
        "packages/rules-gdpr/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/test/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "**/test/fixtures"
  ]
}
