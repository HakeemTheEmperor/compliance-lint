{
  "name": "compliance-lint-workspace",
  "private": true,
  "description": "Workspace root for complinter and its packages.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:coverage": "c8 --reporter=text --reporter=lcov node scripts/run-tests.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "tsc -b --clean tsconfig.build.json && node -e \"require('fs').rmSync('packages/complinter/dist',{recursive:true,force:true})\"",
    "build": "tsc -b tsconfig.build.json && npm run build --workspace complinter"
  },
  "author": "Toluwalase Akinyemi",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "c8": "^12.0.0",
    "eslint": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "engines": {
    "node": ">=18.3.0"
  }
}
