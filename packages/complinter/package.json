{
  "name": "complinter",
  "version": "1.0.0",
  "private": true,
  "description": "Static analysis CLI that flags GDPR/privacy compliance risks in TypeScript and JavaScript code.",
  "files": [
    "dist"
  ],
  "bin": {
    "complint": "./dist/cli.js"
  },
  "exports": {
    "./plugin-api": {
      "types": "./dist/plugin-api.d.ts",
      "default": "./dist/plugin-api.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "plugin-api": [
        "dist/plugin-api.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsup"
  },
  "keywords": [
    "gdpr",
    "compliance",
    "privacy",
    "linter",
    "static-analysis",
    "ast",
    "typescript",
    "cli"
  ],
  "author": "Toluwalase Akinyemi",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@typescript-eslint/typescript-estree": "^8.69.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HakeemTheEmperor/compliance-lint.git",
    "directory": "packages/complinter"
  },
  "homepage": "https://github.com/HakeemTheEmperor/compliance-lint#readme",
  "bugs": {
    "url": "https://github.com/HakeemTheEmperor/compliance-lint/issues"
  },
  "engines": {
    "node": ">=18.3.0"
  },
  "devDependencies": {
    "@complinter/core": "*",
    "@complinter/lang-typescript": "*",
    "@complinter/rules-gdpr": "*",
    "@complinter/plugin-nestjs": "*"
  }
}
